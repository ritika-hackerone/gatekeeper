# --- Database ---
# Defaults to a local SQLite file if unset. In production, set this to your
# Render/Supabase/Neon Postgres connection string.
DATABASE_URL=sqlite:///./gatekeeper.db

# --- Auth (JWT) ---
# MUST be a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS / frontend ---
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGINS=http://localhost:3000
# Used to build links back to the frontend (password reset, Google callback redirect).
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (Sign in with Google) ---
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Email (for "forgot password") ---
# Leave blank to just print reset emails to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@abrobot.ai

# --- P1 Atlas (tuition/living-cost data) ---
ATLAS_API_BASE=
ATLAS_API_KEY=
